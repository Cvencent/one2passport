CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 改用系统堆(malloc/free)而不是固定内建池。C3 可用 RAM 只有 ~330KB,
# 固定池会永久占住连续内存: 收音机/小智/Codex 各要 20~25KB 连续块, 池一占
# 就再也拼不出来(实测 Opus 24.5KB 与 OTA TLS 20KB 互相挤死)。改走系统堆后
# 页面销毁即归还, 峰值释放约 50KB。
CONFIG_LV_USE_CLIB_MALLOC=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_STDLIB_MALLOC=1
# LVGL 绘制图层上限。默认 simple layer 一次要 24KB 连续内存, 而 C3 在收音机
# 播放 + 桥接同时运行时最大空闲块常只有 1~4KB —— 任何 style_opa<255 的控件
# 都会让绘制路径 malloc 失败。UI 侧已改用预混颜色避免触发图层, 这里再把
# 上限压到 4KB 作为兜底: 真触发时按块绘制, 慢一点但不会崩。
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=4096
CONFIG_LV_DRAW_LAYER_MAX_MEMORY=8192
# 圆角遮罩缓存槽位(默认 4)。收音机主页圆角档位收敛到 0/4/8 后仍有圆形
# 指示灯等, 槽位不够就会每帧 malloc/free 遮罩 —— 堆紧张时那次分配失败会让
# LVGL 绘制路径空指针崩溃。每槽只花 radius*4 字节, 留足余量更划算。
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=6
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_FREERTOS_HZ=1000

CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_SNAPSHOT=y
# CONFIG_AUDIO_DECODER_AAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G711_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRNB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRWB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_FLAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_OPUS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_VORBIS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ADPCM_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ALAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_PCM_SUPPORT is not set
# CONFIG_AUDIO_DECODER_SBC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_LC3_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G722_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT is not set

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
# 2026-10-25: 真机 ping 丢包 43-50%(TCP 吞吐坍缩成涓流, 同源 PC 满速)。
# 收包缓冲/窗口/发送缓冲加大后 ping 丢包归零。动态收包缓冲按需分配,
# 平时不多占; 窗口只在有 TCP 连接(收音机播放)时生效。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
# 说明: C3 内存吃紧, WiFi 收发缓冲按单 STA 场景压到最小可用值
# (原 DYNAMIC_RX/TX=16 是调试期调高的, 每缓冲约 1.6KB, 多占 ~25KB)

# CONFIG_BT_ENABLED is not set

# ---- LWIP TCP 缓冲调优(2026-10-10, 为收音机播放腾连续内存) ----
# 背景: 播放网络电台时 esp_http_client 会建立一条 TCP 连接。IDF 默认给每条
# 连接分配 SND_BUF=5760 + WND=5760 ≈ 11.5KB **连续内部内存**, 而 MP3 解码器
# 首帧需要 ~20KB 连续块 —— 实测播放时 largest 被压到 13824, 解码器起不来
# (差 6.6KB), 收音机播不了。
#
# 本设备是**单向接收音频流**(发出去的只有两行 HTTP 请求头),
# 因此发送方向保持最小。接收窗口的取值见下方 2026-10-13 的实测修正
# (曾缩到 2880, 结果高码率台吞吐不足, 已调回 4*MSS)。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
# ⚠ 2026-10-13 实测: 2880(2*MSS) 的接收窗口会把高码率台卡死。
# 44.1kHz 立体声 MP3(~128kbps≈16KB/s) 下, 吞吐 = window/RTT; RTT 稍高
# (200~300ms, 国内 CDN) 就只有 9~14KB/s —— 实测同一电台 pcm 仅 3s/10s,
# 一直在 rebuffer。改成 4*MSS 后同一电台能连续播满(pcm 9.8s/10s, 队列常满)。
# 接收窗口只限制"同时能有多少字节在途", 不额外常驻大块堆。
CONFIG_LWIP_TCP_WND_DEFAULT=8720
# 收发邮箱各减 1(每项约 4 字节指针 + 少量结构, 主要省的是关联缓冲)
CONFIG_LWIP_TCP_RECVMBOX_SIZE=4
CONFIG_LWIP_UDP_RECVMBOX_SIZE=4
CONFIG_LWIP_TCP_SNDMBOX_SIZE=4
# A radio stream is intentionally torn down when the user changes station.
# Normal close leaves the old PCB and its RX buffers in TIME_WAIT for TCP_MSL.
# Three quick station changes then consume nearly all DMA-capable heap, and the
# next DNS lookup fails with getaddrinfo()=202. Allow radio_player to set
# SO_LINGER=0 so its deliberate stream cancellation closes immediately.
CONFIG_LWIP_SO_LINGER=y

# ---- ESP WebSocket: separate tx lock (2026-10-12) ----
# Without this, esp_websocket_client_recv() holds client->lock while doing a
# blocking read of up to network_timeout_ms. The xiaozhi TTS playback task
# (higher prio than the websocket task) then starves the lock holder and every
# send times out - "first turn OK, then no more recognition". Separate tx lock
# decouples sends from the receive path.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000

CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024

# DNS servers: cap at two to bound resolution latency. The device has shown
# intermittent EAI_FAIL on every DNS server even with plenty of free heap, and
# lwIP retries each server on a 1+2+3+4s schedule. A third DHCP-provided server
# can push one getaddrinfo() to roughly 30s and block the radio worker.
CONFIG_LWIP_DNS_MAX_SERVERS=2
